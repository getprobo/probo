# Stage 1: Build frontend assets
FROM node:24-alpine AS frontend
RUN apk add --no-cache findutils
WORKDIR /app
COPY package.json package-lock.json turbo.json relay.config.json ./
COPY apps/ apps/
COPY packages/ packages/
# Relay compiler needs GraphQL schemas from the Go API.
# Upstream split each API's schema into multiple files under graphql/;
# the combined schema.graphql files are generated via merge-graphql-schema.sh.
COPY pkg/server/api/connect/v1/graphql/ pkg/server/api/connect/v1/graphql/
COPY pkg/server/api/console/v1/graphql/ pkg/server/api/console/v1/graphql/
COPY pkg/server/api/trust/v1/graphql/   pkg/server/api/trust/v1/graphql/
COPY contrib/merge-graphql-schema.sh    contrib/merge-graphql-schema.sh
RUN sh contrib/merge-graphql-schema.sh pkg/server/api/connect/v1/schema.graphql pkg/server/api/connect/v1/graphql \
 && sh contrib/merge-graphql-schema.sh pkg/server/api/console/v1/schema.graphql pkg/server/api/console/v1/graphql \
 && sh contrib/merge-graphql-schema.sh pkg/server/api/trust/v1/schema.graphql   pkg/server/api/trust/v1/graphql
RUN npm ci
RUN npm run relay
RUN npx turbo run build

# Stage 2: Build Go binary
FROM golang:1.26-alpine AS backend
RUN apk add --no-cache git
ENV GOPRIVATE=go.probo.inc
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Overwrite with Docker-built frontend assets
COPY --from=frontend /app/apps/console/dist apps/console/dist
COPY --from=frontend /app/apps/trust/dist apps/trust/dist
COPY --from=frontend /app/packages/emails/dist packages/emails/dist
RUN go generate ./...
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s -X 'main.version=dev' -X 'main.env=prod'" \
    -o /probod ./cmd/probod
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /probod-bootstrap ./cmd/probod-bootstrap

# Stage 3: Runtime (Alpine — matches working Render pattern)
FROM alpine:latest
RUN apk --no-cache add ca-certificates openssl bash && \
    addgroup -g 1000 probo && \
    adduser -D -u 1000 -G probo probo && \
    mkdir -p /etc/probod && \
    chown probo:probo /etc/probod
ENV PATH="/app:${PATH}"
WORKDIR /app
COPY --from=backend --chown=probo:probo /probod ./probod
COPY --from=backend --chown=probo:probo /probod-bootstrap ./probod-bootstrap
COPY --chown=probo:probo entrypoint.sh ./entrypoint.sh
COPY --chown=probo:probo rds-ca-bundle.pem ./rds-ca-bundle.pem
USER probo
EXPOSE 8080
CMD ["bash", "./entrypoint.sh"]
