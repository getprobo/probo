# Copy to .env (git-ignored) and source it before running the Go test client.
# The issuer is your Render service URL + /realms/govrly-test
OIDC_ISSUER=https://govrly-keycloak.onrender.com/realms/govrly-test
OIDC_CLIENT_ID=govrly-api
# Admin Console -> govrly-test -> Clients -> govrly-api -> Credentials -> Client secret
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:3000/callback
OIDC_SCOPES=openid profile email
