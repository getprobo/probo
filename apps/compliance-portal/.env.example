# GraphQL API origin (compliance-portal HTTPS origin; <slug> is the portal
# slug). For local Vite development, set this to http://localhost:5174 so the
# browser hits the Vite origin and /graphql is proxied (see vite.config.ts).
VITE_API_URL=https://<slug>.probopage.localhost

# Origin of PROBOD_BASE_URL — used for CSP img-src/connect-src (public file
# downloadUrl hosts). Defaults to the origin of VITE_API_URL when unset.
# COMPLIANCE_PORTAL_APP_ORIGIN=http://127.0.0.1:8080

# Origin of object storage after /api/files/v1/{id} 307s (CSP
# img-src/connect-src for brand/reference logos). When unset, derived like
# production from PROBOD_AWS_* (endpoint/region/bucket/use-path-style),
# including virtual-hosted https://{bucket}.{endpoint}. Or set explicitly:
# COMPLIANCE_PORTAL_FILE_STORAGE_ORIGIN=http://127.0.0.1:8333
# PROBOD_AWS_ENDPOINT=http://127.0.0.1:8333
# PROBOD_AWS_BUCKET=probod
# PROBOD_AWS_USE_PATH_STYLE=true

# Vite /graphql proxy target (compliance-portal HTTPS origin; <slug> is the
# portal slug). Required for local Vite development — uncomment and set the
# slug when running the app locally (see vite.config.ts).
# COMPLIANCE_PORTAL_PROXY_TARGET=https://<slug>.probopage.localhost
