VITE_API_URL=http://localhost:8080

# Origin of PROBOD_BASE_URL — used for CSP img-src/connect-src (absolute
# downloadUrl hosts). Defaults to the origin of VITE_API_URL when unset.
# CONSOLE_APP_ORIGIN=http://localhost:8080

# Object-storage origin after private /api/files/v1/{id} 307s (CSP
# img-src/connect-src). Derived like production from PROBOD_AWS_*
# (endpoint/region/bucket/use-path-style), including virtual-hosted
# https://{bucket}.{endpoint}:
# PROBOD_AWS_ENDPOINT=http://127.0.0.1:8333
# PROBOD_AWS_BUCKET=probod
# PROBOD_AWS_USE_PATH_STYLE=true
