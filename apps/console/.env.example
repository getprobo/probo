VITE_API_URL=http://localhost:8080

# Origin of PROBOD_BASE_URL — used for CSP img-src/connect-src (absolute
# downloadUrl hosts). Defaults to the origin of VITE_API_URL when unset.
# CONSOLE_APP_ORIGIN=http://localhost:8080

# Origin of object storage after private /api/files/v1/{id} 307s (CSP
# img-src/connect-src). Defaults to the origin of PROBOD_AWS_ENDPOINT when
# unset. Match local SeaweedFS (path-style) from the repo root .env.
# CONSOLE_FILE_STORAGE_ORIGIN=http://127.0.0.1:8333
