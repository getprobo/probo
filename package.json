{
  "name": "probo",
  "description": "Probo monorepo containing applications and shared packages",
  "engines": {
    "node": "^24.15.0",
    "npm": "^12.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "node scripts/check-german-locale-parity.mjs && eslint . --concurrency auto && npm -w @probo/n8n-nodes-probo run lint",
    "check": "node scripts/check-german-locale-parity.mjs && turbo run check",
    "relay": "relay-compiler"
  },
  "devDependencies": {
    "@probo/eslint-config": "1.0.0",
    "eslint": "^10.8.0",
    "relay-compiler": "^21.0.1",
    "turbo": "^2.10.8"
  },
  "overrides": {
    "@langchain/classic": "1.0.41",
    "@langchain/community": "1.1.29",
    "nanoid": "^3.3.18",
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true
  },
  "license": "MIT",
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "react-dom": "^19.2.8"
  }
}
