{
  "name": "probo",
  "description": "Probo monorepo containing applications and shared packages",
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.8.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --concurrency auto && npm -w @probo/n8n-nodes-probo run lint",
  "check": "turbo run check",
  "test": "turbo run test",
  "relay": "relay-compiler"
  },
  "devDependencies": {
    "@probo/eslint-config": "1.0.0",
    "eslint": "^10.8.0",
    "relay-compiler": "^21.0.1",
    "turbo": "^2.10.8"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "@langchain/classic": {
      "uuid": "$uuid"
    },
    "@langchain/community": {
      "uuid": "$uuid"
    },
    "langchain": {
      "uuid": "$uuid"
    },
    "n8n-workflow": {
      "uuid": "$uuid"
    },
    "js-yaml": "^4.2.0",
    "glob": "^13.0.6",
    "postcss": "8.5.23",
    "react-router": "^8.3.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true,
    "core-js": false,
    "isolated-vm": false,
    "eslint-plugin-n8n-nodes-base": false
  },
  "license": "MIT",
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "react-dom": "^19.2.8"
  }
}
