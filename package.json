{
  "name": "probo",
  "description": "Probo monorepo containing applications and shared packages",
  "engines": {
    "node": "^24.15.0",
    "npm": "^12.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --concurrency auto && npm -w @probo/n8n-nodes-probo run lint",
    "check": "turbo run check",
    "relay": "relay-compiler"
  },
  "devDependencies": {
    "@probo/eslint-config": "1.0.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^10.9.1",
    "relay-compiler": "^21.0.1",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "overrides": {
    "@langchain/classic": "1.0.41",
    "@langchain/community": "1.1.29",
    "browserslist": "^4.28.7",
    "nanoid": "^3.3.18",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true
  },
  "license": "MIT",
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "react-dom": "^19.2.8"
  }
}
